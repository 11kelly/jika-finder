// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id          String   @id @default(cuid())
  shop        String
  name        String
  address     String
  city        String?
  province    String?
  country     String?
  zip         String?
  phone       String?
  email       String?
  website     String?
  latitude    Float?
  longitude   Float?
  hours       String?  // Store as JSON string
  gbpId       String?  // Google Business Profile ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
}

model Settings {
  id               String   @id @default(cuid())
  shop             String   @unique
  googleMapsApiKey String?
  googleMapId      String?
  layout           String   @default("classic") // classic, mobile-first
  // Appearance customization
  primaryColor     String   @default("#000000")
  secondaryColor   String   @default("#666666")
  accentColor      String   @default("#000000")
  textColor        String   @default("#333333")
  bgColor          String   @default("#ffffff")
  markerColor      String   @default("#ff0000")
  markerSize       Int      @default(32)
  markerIconUrl    String?
  mapStyle           String   @default("default") // default | silver | dark | retro
  mapType            String   @default("roadmap")
  mapUseCustomColors Boolean  @default(false)
  mapColorLand       String   @default("#e5e3df")
  mapColorWater      String   @default("#c0d8e8")
  mapColorRoad       String   @default("#ffffff")
  mapColorLabel      String   @default("#616161")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
