<div id="jika-widget-root"
     data-proxy-url="/apps/store-finder"
     data-button-color="{{ block.settings.button_color }}"
     data-heading="{{ block.settings.heading | escape }}"
     data-position="{{ block.settings.position }}"
     {{ block.shopify_attributes }}></div>

<link rel="stylesheet" href="{{ 'store-finder-widget.css' | asset_url }}">
<script src="{{ 'store-finder-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store Finder Widget",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Widget heading",
      "default": "Find a Store Near You"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Button position",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-right"
    }
  ]
}
{% endschema %}
